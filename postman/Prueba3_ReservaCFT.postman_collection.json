{
  "info": {
    "name": "Prueba 3 - Reserva CFT",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Listar espacios",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/espacios",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "espacios"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Hay 2 espacios', () => pm.expect(pm.response.json().length).to.eql(2));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Crear reserva valida",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Ana Perez\",\n  \"tipo\": \"Sala\",\n  \"horas\": 3\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/reservas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reservas"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.test('Total 54000', () => pm.expect(pm.response.json().total).to.eql(54000));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Reserva invalida horas 0",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Ana Perez\",\n  \"tipo\": \"Sala\",\n  \"horas\": 0\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/reservas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reservas"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));",
              "pm.test('Tiene error', () => pm.expect(pm.response.json()).to.have.property('error'));"
            ]
          }
        }
      ]
    }
  ]
}